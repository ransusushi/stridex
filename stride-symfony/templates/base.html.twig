<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}StrideX Admin{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: #f5f4f0;
            color: #111;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
        }

        /* ---------- Sidebar ---------- */
        .sidebar {
            width: 240px;
            background: #0e0e0e;
            color: #fff;
            display: flex;
            flex-direction: column;
            padding: 24px 0;
            min-height: 100vh;
            position: fixed;
            left: 0; top: 0; bottom: 0;
            overflow-y: auto;
        }
        .sidebar-logo {
            padding: 0 24px 32px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }
.sidebar-logo img {
    height: 40px;
    width: auto;
    display: block;
    max-width: 160px;
}

        .sidebar-group {
            padding: 20px 24px 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .25em;
            text-transform: uppercase;
            color: #555;
        }
        .sidebar-nav { list-style: none; }
        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 24px;
            color: #ccc;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all .2s;
            border-left: 3px solid transparent;
        }
        .sidebar-nav a:hover { background: #1a1a1a; color: #fff; }
        .sidebar-nav a.active { background: #1a1a1a; color: #fff; border-left-color: #ff5a1f; }
        .sidebar-nav a svg { width: 18px; height: 18px; flex-shrink: 0; }
        .sidebar-nav .badge {
            margin-left: auto;
            background: #ff5a1f;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 10px;
        }

        /* ---------- Main ---------- */
        .main { flex: 1; margin-left: 240px; min-height: 100vh; display: flex; flex-direction: column; }

        .topbar {
            background: #fff;
            border-bottom: 1px solid #e5e5e5;
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .topbar h1 { font-size: 18px; font-weight: 600; color: #111; }
        .topbar-user { display: flex; align-items: center; gap: 12px; font-size: 14px; color: #333; }
        .topbar-user .avatar {
            width: 36px; height: 36px;
            background: #f5b342;
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }
        .content { padding: 40px 32px; flex: 1; }

        /* ---------- Cards ---------- */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }
        .stat { background: #fff; border: 1px solid #e5e5e5; border-radius: 8px; padding: 24px; }
        .stat .value {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 42px;
            line-height: 1;
            color: #111;
            margin-bottom: 6px;
        }
        .stat .label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: #888;
        }
        .stat--orange .value { color: #ff5a1f; }

        .card {
            background: #fff;
            border: 1px solid #e5e5e5;
            border-radius: 8px;
            padding: 24px;
        }
    </style>
</head>
<body>

<aside class="sidebar">
    <a href="{{ path('admin_dashboard') }}" class="sidebar-logo">
        <img src="{{ asset('image/stridex-logo.png') }}" alt="StrideX Admin">
    </a>

    <div class="sidebar-group">Overview</div>
    <ul class="sidebar-nav">
        <li>
            <a href="{{ path('admin_dashboard') }}" class="{% if app.request.attributes.get('_route') == 'admin_dashboard' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                Dashboard
            </a>
        </li>
    </ul>

    <div class="sidebar-group">Shop</div>
    <ul class="sidebar-nav">
        <li>
            <a href="{{ path('admin_orders') }}" class="{% if app.request.attributes.get('_route') == 'admin_orders' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 7h14l-1 13H6L5 7Z"/><path d="M9 7a3 3 0 1 1 6 0"/></svg>
                Orders
            </a>
        </li>
        <li>
            <a href="{{ path('admin_products') }}" class="{% if app.request.attributes.get('_route') == 'admin_products' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 7 9-4 9 4-9 4-9-4Z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/></svg>
                Products
            </a>
        </li>
        <li>
            <a href="{{ path('admin_inventory') }}" class="{% if app.request.attributes.get('_route') == 'admin_inventory' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/></svg>
                Inventory
            </a>
        </li>
    </ul>

    <div class="sidebar-group">People</div>
    <ul class="sidebar-nav">
        <li>
            <a href="{{ path('admin_customers') }}" class="{% if app.request.attributes.get('_route') == 'admin_customers' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                Customers
            </a>
        </li>
        <li>
            <a href="{{ path('admin_messages') }}" class="{% if app.request.attributes.get('_route') == 'admin_messages' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Messages
            </a>
        </li>
        <li>
            <a href="{{ path('admin_reviews') }}" class="{% if app.request.attributes.get('_route') == 'admin_reviews' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 18l-5.9 3 1.2-6.5L2.5 9.9 9.1 9Z"/></svg>
                Reviews
            </a>
        </li>
    </ul>
</aside>

<main class="main">
    <div class="topbar">
        <h1>{% block page_title %}Dashboard{% endblock %}</h1>
        <div class="topbar-user">
            <span>Admin</span>
            <div class="avatar">A</div>
        </div>
    </div>

    <div class="content">
        {% block body %}{% endblock %}
    </div>
</main>

</body>
</html>