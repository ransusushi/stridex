<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}StrideX &mdash; Built for the Streets{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/stridex.css') }}">
    <link rel="stylesheet" href="{{ asset('css/collection.css') }}?v=why-stridex-hero-17">
    <style>
        .store-header-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            color: #fff;
            text-decoration: none;
        }

        .store-header-icon:hover,
        .store-header-icon:focus-visible {
            color: #ff5a1f;
        }

        .store-header-icon:focus-visible {
            outline: 2px solid currentColor;
            outline-offset: 4px;
        }

        .store-header-icon svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-width: 1.7;
        }
    </style>
    {% block extra_css %}{% endblock %}
</head>
<body style="margin: 0; padding: 0; background: #000;">

<header class="store-header">
    <div class="store-header-inner">
        <a href="{{ path('app_storefront') }}" class="store-logo">
            <img src="{{ asset('image/stridex-logo.png') }}" alt="StrideX">
        </a>

        <nav class="store-desktop-nav" aria-label="Primary navigation">
            <a href="{{ path('app_storefront') }}">HOME</a>
            <a href="{{ path('app_shop') }}">SHOP</a>
            <a href="{{ path('app_collections') }}">COLLECTIONS</a>
            <a href="{{ path('app_about') }}">ABOUT US</a>
            <a href="{{ path('app_contact') }}">CONTACT US</a>
        </nav>

        <details class="store-mobile-menu">
            <summary aria-label="Open navigation menu">MENU</summary>
            <nav class="store-mobile-menu-links" aria-label="Mobile navigation">
                <a href="{{ path('app_storefront') }}">HOME</a>
                <a href="{{ path('app_shop') }}">SHOP</a>
                <a href="{{ path('app_collections') }}">COLLECTIONS</a>
                <a href="{{ path('app_about') }}">ABOUT US</a>
                <a href="{{ path('app_contact') }}">CONTACT US</a>
            </nav>
        </details>

        <div class="store-header-actions">
            {% if app.user %}
                <a href="{{ path('app_profile') }}" class="store-header-icon" aria-label="Profile" title="Profile">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>
                </a>
                <a href="{{ path('app_cart') }}" class="store-header-icon" aria-label="Cart" title="Cart">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>
                </a>
                <a class="store-header-action-link" href="{{ path('app_logout') }}">LOGOUT</a>
            {% else %}
                <a class="store-header-action-link" href="{{ path('app_login') }}">SIGN IN</a>
            {% endif %}
        </div>
    </div>
</header>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div style="max-width:1200px;margin:16px auto;padding:14px 20px;border-radius:6px;background:#111;border:1px solid {{ label == 'error' ? '#ff5a1f' : '#4ade80' }};color:{{ label == 'error' ? '#ff5a1f' : '#4ade80' }};">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

{% block body %}{% endblock %}

<footer class="site-footer store-footer">
    <div class="store-footer-main">
        <div>
            <img class="store-footer-logo" src="{{ asset('image/stridex-logo.png') }}" alt="StrideX">
            <p style="color: #888; font-size: 11px; letter-spacing: 0.2em;">MOVE IN STYLE. LIVE WITHOUT LIMITS.</p>
        </div>
        <div class="store-footer-links">
            <div class="store-footer-column">
                <h4 class="store-footer-heading">SHOP</h4>
                <ul class="store-footer-list">
                    <li><a href="{{ path('app_shop') }}">All Products</a></li>
                    <li><a href="{{ path('app_collections') }}">Collections</a></li>
                </ul>
            </div>
            <div class="store-footer-column">
                <h4 class="store-footer-heading">COMPANY</h4>
                <ul class="store-footer-list">
                    <li><a href="{{ path('app_about') }}">About Us</a></li>
                    <li><a href="{{ path('app_about') }}">Our Mission</a></li>
                </ul>
            </div>
            <div class="store-footer-column">
                <h4 class="store-footer-heading">SUPPORT</h4>
                <ul class="store-footer-list">
                    <li><a href="{{ path('app_contact') }}">Contact Us</a></li>
                    <li><a href="{{ path('app_about') }}#faq">FAQ</a></li>
                </ul>
            </div>
            <div class="store-footer-column">
                <h4 class="store-footer-heading">FOLLOW US</h4>
                <ul class="store-footer-list">
                    <li><span>Instagram</span></li>
                    <li><span>Facebook</span></li>
                    <li><span>TikTok</span></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="store-footer-bottom">
        <p>&copy; {{ "now"|date("Y") }} STRIDEX. ALL RIGHTS RESERVED.</p>
        <div class="store-footer-legal"><span>PRIVACY</span><span>TERMS</span><span>COOKIES</span></div>
    </div>
</footer>
</body>
</html>
