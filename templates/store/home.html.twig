{% extends 'store/base_store.html.twig' %}

{% block title %}StrideX &mdash; Built for the Streets{% endblock %}

{% block body %}
<section class="coll-hero">
    <div class="coll-hero-inner">
        <div class="coll-hero-copy">
            <span class="coll-eyebrow">EVERY STEP COUNTS.</span>
            <h1 class="coll-title">
                BUILT<br>
                <span class="outline">FOR THE</span><br>
                STREETS
            </h1>
            <p class="coll-lead">Performance. Comfort. Style. Every step you take, we&rsquo;ve got your back.</p>
            <div class="coll-hero-actions">
                <a href="{{ path('app_shop') }}" class="coll-cta">SHOP NOW &rarr;</a>
                <a href="{{ path('app_collections') }}" class="coll-cta coll-cta--outline">EXPLORE COLLECTION</a>
            </div>
            <div class="coll-hero-stats" aria-label="StrideX at a glance">
                <div class="coll-hero-stat"><strong>12K+</strong><span>ATHLETES</span></div>
                <div class="coll-hero-stat"><strong>98%</strong><span>SATISFACTION</span></div>
                <div class="coll-hero-stat"><strong>50+</strong><span>STYLES</span></div>
            </div>
        </div>
        <div class="coll-hero-visual">
            <img src="{{ asset('image/hero.png') }}" alt="StrideX Shoe">
        </div>
    </div>
</section>

<section class="dark-section">
    <div class="container">
        <div class="section-header-split" style="align-items: flex-end; margin-bottom: 40px;">
            <div>
                <span class="eyebrow" style="color: var(--accent);">THE NEW DROP</span>
                <h2 class="light-title home-drop-title">YOUR NEXT PAIR<span>.</span></h2>
            </div>
            <div>
                <a href="{{ path('app_shop') }}" class="btn btn--primary">VIEW ALL FOOTWEAR &rarr;</a>
            </div>
        </div>

        <div class="product-grid">
            {% for p in featuredProducts %}
                <article class="product-card">
                    <div class="product-media {{ p.bg ?: 'bg-black' }}">
                        {% if p.badge %}
                            <span class="product-badge">{{ p.badge }}</span>
                        {% endif %}
                        {% if p.image %}
                            <img src="{{ asset(p.image) }}" alt="{{ p.name }}">
                        {% endif %}
                    </div>
                    <div class="product-info">
                        <p class="product-color">{{ p.color ?: p.category }}</p>
                        <div class="product-row">
                            <h3 class="product-name">{{ p.name }}</h3>
                            <span class="product-price">${{ p.price }}</span>
                        </div>
                        <p style="color: var(--muted); font-size: 12px; margin-top: 6px;">
                            {{ p.stockQuantity }} in stock &bull; Added by {{ p.createdBy.name }}
                        </p>
                        <div class="product-actions" style="margin-top: 16px; display: flex; gap: 10px;">
                            <form method="post" action="{{ path('app_cart_action') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                                <input type="hidden" name="id" value="{{ p.id }}">
                                <input type="hidden" name="action" value="add">
                                <button type="submit" class="btn btn--primary" style="padding: 10px 20px; font-size: 10px;">ADD TO CART</button>
                            </form>
                            <a href="{{ path('app_product_show', {id: p.id}) }}" class="btn" style="padding: 10px 16px; font-size: 10px; border: 1px solid #333; color: #fff;">DETAILS</a>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    </div>
</section>

<section class="home-editorial">
    <div class="container split-editorial">
        <div class="editorial-img">
            <img src="{{ asset('image/white_edge.png') }}" alt="Movement">
        </div>
        <div class="editorial-copy">
            <span class="eyebrow editorial-eyebrow home-editorial-eyebrow">THE STRIDEX STANDARD</span>
            <h2 class="light-title home-editorial-title">MOVEMENT SHOULD NEVER <span>FEEL LIMITED.</span></h2>
            <p class="home-editorial-copy">We make footwear for people who move through the city with purpose. Responsive comfort, durable construction, and a silhouette that works beyond the track.</p>
            <a href="{{ path('app_about') }}" class="btn btn--primary home-editorial-link">READ OUR STORY &rarr;</a>
        </div>
    </div>
</section>
<section class="why-stridex" aria-labelledby="why-stridex-title">
    <div class="why-stridex-inner">
        <h2 id="why-stridex-title">WHY CHOOSE STRIDEX?</h2>
        <div class="why-stridex-grid">
            <article class="why-stridex-card">
                <span class="why-stridex-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 3 19 6v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3Z"/>
                        <path d="m9 12 2 2 4-4"/>
                    </svg>
                </span>
                <h3>PREMIUM QUALITY</h3>
                <p>High-grade materials ensure lasting durability and all-day comfort.</p>
            </article>
            <article class="why-stridex-card">
                <span class="why-stridex-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M13 2 4 14h7l-1 8 10-13h-7l1-7Z"/>
                    </svg>
                </span>
                <h3>PERFORMANCE</h3>
                <p>Engineered for speed, agility, and stability on every surface.</p>
            </article>
            <article class="why-stridex-card">
                <span class="why-stridex-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M9 18h6M10 22h4M8 14a6 6 0 1 1 8 0c-.8.7-1 1.3-1 2H9c0-.7-.2-1.3-1-2Z"/>
                        <path d="M12 2v2M4.9 4.9l1.4 1.4M19.1 4.9l-1.4 1.4"/>
                    </svg>
                </span>
                <h3>INNOVATION</h3>
                <p>Thoughtful design and modern materials for every move.</p>
            </article>
            <article class="why-stridex-card">
                <span class="why-stridex-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 3 20 6v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-3Z"/>
                        <path d="m8 12 2.5 2.5L16 9"/>
                    </svg>
                </span>
                <h3>BEST VALUE</h3>
                <p>Everyday comfort and performance at a value you can feel.</p>
            </article>
        </div>
    </div>
</section>
<!-- CTA SECTION -->
<section class="cta-section">
    <div class="cta-content">
        <div class="cta-copy">
            <span class="cta-eyebrow">MOVE IN STYLE.</span>
            <h2 class="cta-title">LIVE WITHOUT<br>LIMITS<span>.</span></h2>
            <p class="cta-description">StrideX is here to keep you moving with confidence, comfort, and unstoppable energy.</p>
            <a href="{{ path('app_shop') }}" class="cta-button">JOIN THE MOVEMENT &rarr;</a>
        </div>
    </div>
</section>
{% endblock %}
