{% extends 'base.html.twig' %}

{% block title %}Customer Orders | StrideX{% endblock %}

{% block body %}
<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; }
    .page-title { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; letter-spacing: 0.05em; margin: 0; color: #fff; line-height: 1; }

    .table-wrap { background: #0e0e0e; border: 1px solid #222; border-radius: 8px; overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th { background: #111; color: #888; font-size: 10px; letter-spacing: 0.1em; padding: 16px; text-align: left; border-bottom: 1px solid #222; font-weight: 600; text-transform: uppercase; }
    .data-table td { padding: 16px; border-bottom: 1px solid #222; font-size: 13px; vertical-align: middle; color: #ccc; }
    .data-table tr:hover { background: rgba(255,255,255,0.02); }

    .badge { padding: 4px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
    .badge-pending { background: rgba(245, 179, 66, 0.15); color: #f5b342; }
    .badge-paid { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
    .badge-shipped { background: rgba(96, 165, 250, 0.15); color: #60a5fa; }
    .badge-delivered { background: rgba(167, 139, 250, 0.15); color: #a78bfa; }

    .btn-action { padding: 6px 12px; border: 1px solid #333; background: transparent; color: #fff; font-size: 10px; font-weight: 700; border-radius: 4px; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-action:hover { border-color: #fff; background: #fff; color: #000; }
    .btn-primary { background: #ff5a1f; border-color: #ff5a1f; color: #fff; }
    .btn-primary:hover { background: #fff; border-color: #fff; color: #000; }

    .status-form { display: flex; gap: 8px; align-items: center; }
    .status-select { padding: 6px 12px; background: #111; border: 1px solid #333; border-radius: 4px; color: #fff; font-size: 12px; outline: none; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Customer Orders</h1>
        <p style="color: #888; margin-top: 5px; font-size: 14px;">Manage and track customer purchases.</p>
    </div>
    <div>
        <a href="{{ path('app_admin_dashboard') }}" style="color: #aaa; font-size: 11px; font-weight: 700; text-decoration: none; letter-spacing: 0.1em;">&larr; BACK TO DASHBOARD</a>
    </div>
</div>

<!-- Quick Stats for Orders -->
<div style="background: #0e0e0e; border: 1px solid #222; border-radius: 8px; padding: 20px; margin-bottom: 30px; display: flex; gap: 40px;">
    <div>
        <span style="color: #888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700;">Total Orders</span>
        <div style="color: #fff; font-size: 28px; font-weight: 700; margin-top: 5px;">{{ orders|length }}</div>
    </div>
    <div>
        <span style="color: #888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700;">Total Revenue</span>
        <div style="color: #22c55e; font-size: 28px; font-weight: 700; margin-top: 5px;">${{ revenueStats.totalRevenue|default('0')|number_format(2) }}</div>
    </div>
</div>

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Transaction ID</th>
                <th>Customer</th>
                <th>Total</th>
                <th>Payment</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
                <tr>
                    <td style="font-weight: 600; color: #ff5a1f;">#{{ order.id }}</td>
                    <td style="font-family: monospace; color: #aaa;">{{ order.transactionId }}</td>
                    <td>
                        <div style="font-weight: 600; color: #fff;">{{ order.firstName }} {{ order.lastName }}</div>
                        <div style="font-size: 11px; color: #888;">{{ order.email }}</div>
                    </td>
                    <td style="color: #fff; font-weight: 600;">${{ order.total|number_format(2) }}</td>
                    <td>{{ order.paymentMethod|upper }}</td>
                    <td>
                        <span class="badge badge-{{ order.status }}">{{ order.status|upper }}</span>
                    </td>
                    <td>{{ order.createdAt|date('M d, Y h:i A') }}</td>
                    <td>
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <a href="{{ path('app_admin_order_show', {id: order.id}) }}" class="btn-action">VIEW</a>

                            <form method="post" action="{{ path('app_admin_order_status', {id: order.id}) }}" class="status-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('order_status_' ~ order.id) }}">
                                <select name="status" class="status-select">
                                    <option value="pending" {% if order.status == 'pending' %}selected{% endif %}>Pending</option>
                                    <option value="paid" {% if order.status == 'paid' %}selected{% endif %}>Paid</option>
                                    <option value="shipped" {% if order.status == 'shipped' %}selected{% endif %}>Shipped</option>
                                    <option value="delivered" {% if order.status == 'delivered' %}selected{% endif %}>Delivered</option>
                                </select>
                                <button type="submit" class="btn-action btn-primary">UPDATE</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" style="text-align: center; padding: 40px; color: #888;">No orders found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
