{% extends 'base.html.twig' %}

{% block title %}Edit Account | StrideX{% endblock %}

{% block body %}
<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; }
    .page-title { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; letter-spacing: 0.05em; margin: 0; color: #fff; line-height: 1; }
    .page-subtitle { color: #888; margin-top: 5px; font-size: 14px; }

    .form-card { background: #0e0e0e; border: 1px solid #222; border-radius: 8px; padding: 40px; max-width: 800px; }

    .form-group { margin-bottom: 24px; }
    .form-group label { display: block; color: #aaa; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }
    .form-group input, .form-group select {
        width: 100%; padding: 14px 16px; background: #111; border: 1px solid #333; border-radius: 4px;
        color: #fff; font-family: 'Inter', sans-serif; font-size: 14px; outline: none; transition: 0.2s; box-sizing: border-box;
    }
    .form-group input:focus, .form-group select:focus { border-color: #ff5a1f; }
    .form-group input[type="checkbox"] { width: auto; margin-right: 10px; }

    .form-help { display: block; color: #666; font-size: 11px; margin-top: 6px; }
    .form-error { color: #ef4444; font-size: 12px; margin-top: 6px; display: block; }

    .btn-primary { background: #ff5a1f; color: #fff; padding: 14px 28px; font-weight: 700; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; border: none; border-radius: 4px; cursor: pointer; transition: 0.2s; text-decoration: none; display: inline-block; }
    .btn-primary:hover { background: #fff; color: #000; }
    .btn-secondary { background: transparent; color: #aaa; padding: 14px 28px; font-weight: 700; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; border: none; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-secondary:hover { color: #fff; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Account: {{ user.name }}</h1>
        <p class="page-subtitle">Update user profile details, system role, account status, or reset password.</p>
    </div>
    <div>
        <a href="{{ path('app_admin_user_index') }}" style="color: #aaa; font-size: 11px; font-weight: 700; text-decoration: none; letter-spacing: 0.1em;">&larr; BACK TO LIST</a>
    </div>
</div>

<div class="form-card">
    {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.email) }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-group">
            {{ form_label(form.primaryRole) }}
            {{ form_widget(form.primaryRole) }}
            {{ form_errors(form.primaryRole) }}
            <span class="form-help">Select the system access level for this account.</span>
        </div>

        <div class="form-group">
            {{ form_label(form.status) }}
            {{ form_widget(form.status) }}
            {{ form_errors(form.status) }}
            <span class="form-help">Set account status to Active, Disabled, or Archived.</span>
        </div>

        <hr style="border: 0; border-top: 1px solid #222; margin: 40px 0;">

        <div class="form-group">
            {{ form_label(form.plainPassword.first) }}
            {{ form_widget(form.plainPassword.first) }}
            {{ form_errors(form.plainPassword.first) }}
        </div>

        <div class="form-group">
            {{ form_label(form.plainPassword.second) }}
            {{ form_widget(form.plainPassword.second) }}
            {{ form_errors(form.plainPassword.second) }}
            <span class="form-help">Leave blank to keep current password. Enter a new password to reset.</span>
        </div>

        <div style="display: flex; gap: 15px; margin-top: 40px;">
            <button type="submit" class="btn-primary">SAVE CHANGES</button>
            <a href="{{ path('app_admin_user_index') }}" class="btn-secondary">CANCEL</a>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
