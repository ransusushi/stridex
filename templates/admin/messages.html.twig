{% extends 'base.html.twig' %}

{% block title %}Customer Messages | StrideX{% endblock %}

{% block body %}
<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; }
    .page-title { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; letter-spacing: 0.05em; margin: 0; color: #fff; line-height: 1; }

    .table-wrap { background: #0e0e0e; border: 1px solid #222; border-radius: 8px; overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th { background: #111; color: #888; font-size: 10px; letter-spacing: 0.1em; padding: 16px; text-align: left; border-bottom: 1px solid #222; font-weight: 600; text-transform: uppercase; }
    .data-table td { padding: 16px; border-bottom: 1px solid #222; font-size: 13px; vertical-align: middle; color: #ccc; }
    .data-table tr:hover { background: rgba(255,255,255,0.02); }

    .badge { padding: 4px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
    .badge-unread { background: rgba(255, 90, 31, 0.15); color: #ff5a1f; border: 1px solid #ff5a1f; }
    .badge-read { background: rgba(255, 255, 255, 0.1); color: #888; border: 1px solid #444; }

    .btn-action { padding: 6px 12px; border: 1px solid #333; background: transparent; color: #fff; font-size: 10px; font-weight: 700; border-radius: 4px; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-action:hover { border-color: #fff; background: #fff; color: #000; }
    .btn-danger { border-color: #ef4444; color: #ef4444; }
    .btn-danger:hover { background: #ef4444; color: #fff; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Customer Messages</h1>
        <p style="color: #888; margin-top: 5px; font-size: 14px;">Messages submitted via the StrideX About Us contact form ({{ unreadCount }} unread).</p>
    </div>
    <div>
        <a href="{{ path('app_admin_dashboard') }}" style="color: #aaa; font-size: 11px; font-weight: 700; text-decoration: none; letter-spacing: 0.1em;">&larr; BACK TO DASHBOARD</a>
    </div>
</div>

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Status</th>
                <th>Date</th>
                <th>Sender</th>
                <th>Subject</th>
                <th>Message</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for message in messages %}
                <tr>
                    <td>
                        {% if not message.isRead %}
                            <span class="badge badge-unread">Unread</span>
                        {% else %}
                            <span class="badge badge-read">Read</span>
                        {% endif %}
                    </td>
                    <td>{{ message.createdAt|date('M d, Y h:i A') }}</td>
                    <td>
                        <div style="font-weight: 600; color: #fff;">{{ message.name }}</div>
                        <div style="font-size: 11px; color: #888;"><a href="mailto:{{ message.email }}" style="color: #ff5a1f; text-decoration: none;">{{ message.email }}</a></div>
                    </td>
                    <td style="font-weight: 600; color: #ccc;">{{ message.subject }}</td>
                    <td style="max-width: 300px; white-space: normal; line-height: 1.5; color: #aaa;">{{ message.message }}</td>
                    <td>
                        <div style="display: flex; gap: 8px;">
                            {% if not message.isRead %}
                                <form method="post" action="{{ path('app_admin_message_read', {id: message.id}) }}" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('read_msg_' ~ message.id) }}">
                                    <button type="submit" class="btn-action">MARK READ</button>
                                </form>
                            {% endif %}

                            <form method="post" action="{{ path('app_admin_message_delete', {id: message.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this message?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_msg_' ~ message.id) }}">
                                <button type="submit" class="btn-action btn-danger">DELETE</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" style="text-align: center; padding: 40px; color: #888;">No messages found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
