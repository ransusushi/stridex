{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | StrideX{% endblock %}

{% block body %}
<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; }
    .page-title { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; letter-spacing: 0.05em; margin: 0; color: #fff; line-height: 1; }
    .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
    .stat-card { background: #0e0e0e; border: 1px solid #222; padding: 24px; border-radius: 8px; display: flex; flex-direction: column; justify-content: center; }
    .stat-label { font-size: 11px; font-weight: 700; color: #888; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 10px; display: flex; justify-content: space-between; }
    .stat-value { font-size: 32px; font-weight: 700; color: #fff; }
    .stat-meta { font-size: 12px; color: #666; margin-top: 8px; }

    .card { background: #0e0e0e; border: 1px solid #222; border-radius: 8px; padding: 24px; margin-bottom: 30px; }
    .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #222; padding-bottom: 15px; }
    .card-title { font-family: 'Bebas Neue', sans-serif; font-size: 28px; margin: 0; color: #fff; letter-spacing: 0.05em; }

    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th { background: transparent; color: #888; font-size: 10px; letter-spacing: 0.1em; padding: 16px; text-align: left; border-bottom: 1px solid #222; font-weight: 600; text-transform: uppercase; }
    .data-table td { padding: 16px; border-bottom: 1px solid #222; font-size: 13px; vertical-align: middle; color: #ccc; }

    .product-name { font-weight: 700; color: #ff5a1f; text-transform: uppercase; font-family: 'Bebas Neue', sans-serif; font-size: 18px; letter-spacing: 0.05em; }
    .badge { padding: 4px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
    .badge-admin { background: rgba(255, 90, 31, 0.15); color: #ff5a1f; border: 1px solid #ff5a1f; }
    .badge-staff { background: rgba(255, 255, 255, 0.1); color: #fff; border: 1px solid #555; }
    .badge-active { background: rgba(34, 197, 94, 0.15); color: #22c55e; }

    /* Edit Button Styling */
    .btn-action { padding: 6px 12px; border: 1px solid #333; background: transparent; color: #fff; font-size: 10px; font-weight: 700; border-radius: 4px; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-action:hover { border-color: #fff; background: #fff; color: #000; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Administrator Dashboard</h1>
        <p style="color: #888; margin-top: 5px; font-size: 14px;">System-wide overview of user accounts, staff members, footwear inventory records, and customer orders.</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a href="{{ path('app_admin_user_new') }}" style="background: #ff5a1f; color: #fff; padding: 12px 24px; font-weight: 700; font-size: 12px; border-radius: 4px; text-decoration: none;">+ CREATE USER</a>
        <a href="{{ path('app_product_new') }}" style="background: #fff; color: #000; padding: 12px 24px; font-weight: 700; font-size: 12px; border-radius: 4px; text-decoration: none;">+ ADD PRODUCT</a>
    </div>
</div>

<!-- Stats -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-label"><span>TOTAL USERS</span></div>
        <div class="stat-value" id="stat-total-users">{{ summary.totalUsers|default('0') }}</div>
        <div class="stat-meta">{{ summary.activeUsers|default('0') }} active &bull; {{ summary.inactiveUsers|default('0') }} inactive</div>
    </div>
    <div class="stat-card">
        <div class="stat-label"><span>TOTAL STAFF</span></div>
        <div class="stat-value" id="stat-total-staff">{{ summary.totalStaff|default('0') }}</div>
        <div class="stat-meta">{{ summary.totalAdmins|default('0') }} administrator(s)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label"><span>TOTAL RECORDS</span></div>
        <div class="stat-value" id="stat-total-records">{{ summary.totalRecords|default('0') }}</div>
        <div class="stat-meta">{{ summary.lowStockRecords|default('0') }} with low stock</div>
    </div>
    <div class="stat-card">
        <div class="stat-label"><span>REVENUE</span></div>
        <div class="stat-value" style="color: #22c55e;">${{ revenueStats.totalRevenue|default('0')|number_format(2) }}</div>
        <div class="stat-meta">{{ revenueStats.totalOrders|default('0') }} order(s) &bull; {{ unreadMessages|default('0') }} unread msg(s)</div>
    </div>
</div>

<!-- Recent Users -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">Recent Users</h2>
        <a href="{{ path('app_admin_user_index') }}" style="color: #aaa; font-size: 11px; font-weight: 700; text-decoration: none; letter-spacing: 0.1em;">VIEW ALL &rarr;</a>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>USER</th>
                <th>ROLE</th>
                <th>STATUS</th>
                <th>ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            {% for u in recentUsers|default([]) %}
                <tr>
                    <td>
                        <div style="font-weight: 600; color: #fff;">{{ u.name|default('Unknown') }}</div>
                        <div style="font-size: 11px; color: #888;">{{ u.email|default('') }}</div>
                    </td>
                    <td>
                        <span class="badge {{ u.isAdmin ? 'badge-admin' : (u.isStaff ? 'badge-staff' : 'badge-active') }}">{{ u.roleLabel }}</span>
                    </td>
                    <td>
                        <span class="badge {{ u.status == 'active' ? 'badge-active' : 'badge-staff' }}">{{ u.status|default('active')|capitalize }}</span>
                    </td>
                    <td>
                        <!-- EDIT BUTTON ADDED HERE -->
                        <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="btn-action">EDIT</a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" style="text-align: center; color: #888;">No recent users.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Recent Products -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">Recent Footwear Records</h2>
        <a href="{{ path('app_product_index') }}" style="color: #aaa; font-size: 11px; font-weight: 700; text-decoration: none; letter-spacing: 0.1em;">VIEW ALL &rarr;</a>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>SNEAKER</th>
                <th>PRICE</th>
                <th>STOCK</th>
                <th>ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            {% for p in recentProducts|default([]) %}
                <tr>
                    <td>
                        <div class="product-name">{{ p.name|default('Unknown') }}</div>
                        <div style="font-size: 11px; color: #888;">{{ p.sku|default('') }} &bull; {{ p.color|default('') }}</div>
                    </td>
                    <td style="color: #fff;">${{ p.price|default('0') }}</td>
                    <td>
                        <span style="color: #ff5a1f; font-weight: 600;">{{ p.stockQuantity|default('0') }}</span>
                    </td>
                    <td>
                        <!-- EDIT BUTTON ADDED HERE -->
                        <a href="{{ path('app_product_edit', {id: p.id}) }}" class="btn-action">EDIT</a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" style="text-align: center; color: #888;">No recent products.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
