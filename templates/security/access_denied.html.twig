{% extends 'base.html.twig' %}

{% block title %}403 Access Denied | Inventory &amp; Staff Portal{% endblock %}

{% block body %}
<div class="auth-wrapper" style="max-width: 560px;">
    <div class="card" style="text-align: center; padding: 2.25rem 1.5rem;">
        <span class="badge badge-danger" style="font-size: 0.85rem; padding: 0.35rem 0.85rem; margin-bottom: 1rem;">
            HTTP 403 &bull; Access Denied
        </span>
        <h1 class="page-title" style="margin-bottom: 0.6rem;">Restricted Area</h1>
        <p class="page-subtitle" style="margin-bottom: 1.5rem;">
            You do not have sufficient permissions to view or modify
            <code>{{ requested_path }}</code>.
            {% if not is_granted('ROLE_ADMIN') %}
                Staff accounts can only edit or delete their own records and cannot access Administrator pages.
            {% endif %}
        </p>

        <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
            <a href="{{ path('app_home') }}" class="btn btn-primary">Return to Dashboard</a>
            <a href="{{ path('app_product_index') }}" class="btn btn-secondary">Browse Products</a>
        </div>
    </div>
</div>
{% endblock %}
