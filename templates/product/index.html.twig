{% extends 'base.html.twig' %}

{% block title %}Inventory | StrideX{% endblock %}

{% block body %}
<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; }
    .page-title { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; letter-spacing: 0.05em; margin: 0; color: #fff; line-height: 1; }
    .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
    .stat-card { background: #0e0e0e; border: 1px solid #222; padding: 24px; border-radius: 8px; display: flex; flex-direction: column; justify-content: center; }
    .stat-label { font-size: 11px; font-weight: 700; color: #888; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 10px; display: flex; justify-content: space-between; }
    .stat-value { font-size: 32px; font-weight: 700; color: #fff; }
    .filter-group-search { flex: 2; }
    @media (max-width: 760px) {
        .filter-bar { flex-wrap: wrap; }
        .filter-group { flex: 1 1 170px; }
        .filter-group-search { flex-basis: 100%; }
    }

    .filter-bar { background: #0e0e0e; border: 1px solid #222; padding: 20px; border-radius: 8px; display: flex; gap: 15px; margin-bottom: 30px; align-items: flex-end; }
    .filter-group { flex: 1; }
    .filter-input { width: 100%; padding: 12px 16px; background: #111; border: 1px solid #333; border-radius: 4px; color: #fff; font-family: 'Inter', sans-serif; outline: none; }
    .filter-input:focus { border-color: #ff5a1f; }

    .table-wrap { background: #0e0e0e; border: 1px solid #222; border-radius: 8px; overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th { background: #111; color: #888; font-size: 10px; letter-spacing: 0.1em; padding: 16px; text-align: left; border-bottom: 1px solid #222; font-weight: 600; text-transform: uppercase; }
    .data-table td { padding: 16px; border-bottom: 1px solid #222; font-size: 13px; vertical-align: middle; color: #ccc; }

    .product-cell { display: flex; align-items: center; gap: 15px; }
    .product-img { width: 50px; height: 50px; border-radius: 4px; background: #222; object-fit: cover; }
    .product-name { font-weight: 700; color: #ff5a1f; text-transform: uppercase; font-family: 'Bebas Neue', sans-serif; font-size: 18px; letter-spacing: 0.05em; }

    .btn-action { padding: 6px 12px; border: 1px solid #333; background: transparent; color: #fff; font-size: 10px; font-weight: 700; border-radius: 4px; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-action:hover { border-color: #fff; background: #fff; color: #000; }
    .btn-delete { border-color: #ef4444; color: #ef4444; }
    .btn-delete:hover { background: #ef4444; color: #fff; }
    .stock-badge { display: inline-block; padding: 4px 9px; border-radius: 12px; font-size: 10px; font-weight: 600; white-space: nowrap; }
    .stock-in { background: rgba(34, 197, 94, 0.12); color: #22c55e; }
    .stock-low { background: rgba(234, 179, 8, 0.12); color: #eab308; }
    .stock-out { background: rgba(239, 68, 68, 0.12); color: #ef4444; }

</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Footwear Inventory</h1>
        <p style="color: #888; margin-top: 5px; font-size: 14px;">Manage product availability across the StrideX catalog.</p>
    </div>
    <a href="{{ path('app_product_new') }}" style="background: #ff5a1f; color: #fff; padding: 12px 24px; font-weight: 700; font-size: 12px; border-radius: 4px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
        + CREATE NEW PRODUCT
    </a>
</div>

<!-- Stats -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-label"><span>TOTAL PRODUCTS</span> <span style="font-size: 14px;">📦</span></div>
        <div class="stat-value" id="stat-total-products">{{ totalRecords }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-label" style="color: #ff5a1f;"><span>LOW STOCK</span> <span style="font-size: 14px;">⚠️</span></div>
        <div class="stat-value" id="stat-low-stock">{{ lowStockCount }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-label"><span>CATEGORIES</span> <span style="font-size: 14px;">🗂️</span></div>
        <div class="stat-value" id="stat-category-count">{{ categories|length }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-label"><span>INVENTORY VALUE</span> <span style="font-size: 14px;">💰</span></div>
        <div class="stat-value" id="stat-inventory-value">${{ inventoryValue|number_format(2) }}</div>
    </div>
</div>

<!-- Filters -->
<form method="get" class="filter-bar">
    <div class="filter-group filter-group-search">
        <input type="text" name="q" class="filter-input" placeholder="Search by name, SKU, description, or color" value="{{ filters.q }}">
    </div>
    <div class="filter-group">
        <select name="category" class="filter-input">
            <option value="">All Categories</option>
            {% for label, category in categories %}
                <option value="{{ category }}" {% if filters.category == category %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="filter-group">
        <select name="stock" class="filter-input">
            <option value="">Any Stock Level</option>
            <option value="low" {% if filters.stock == 'low' %}selected{% endif %}>Low Stock</option>
            <option value="in_stock" {% if filters.stock == 'in_stock' %}selected{% endif %}>In Stock</option>
            <option value="out" {% if filters.stock == 'out' %}selected{% endif %}>Out of Stock</option>
        </select>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
        <div class="filter-group">
            <select name="creator" class="filter-input">
                <option value="">All Creators</option>
                {% for creator in creators %}
                    <option value="{{ creator.id }}" {% if filters.creator == creator.id %}selected{% endif %}>{{ creator.name }}</option>
                {% endfor %}
            </select>
        </div>
    {% endif %}
    <button type="submit" style="background: #ff5a1f; color: #fff; padding: 12px 24px; font-weight: 700; border: none; border-radius: 4px; cursor: pointer;">SEARCH</button>
</form>

<!-- Data Table -->
<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>PRODUCT</th>
                <th>SKU</th>
                <th>CATEGORY & COLOR</th>
                <th>PRICE</th>
                <th>STOCK</th>
                <th>CREATED BY</th>
                <th>CREATED</th>
                <th>ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
                <tr>
                    <td>
                        <div class="product-cell">
                            {% if product.image %}
                                <img src="{{ asset(product.image) }}" class="product-img" alt="">
                            {% else %}
                                <div class="product-img"></div>
                            {% endif %}
                            <div>
                                <div class="product-name">
                                    {{ product.name }}
                                    {% if product.badge %}<span style="background: #222; color: #ccc; padding: 2px 8px; border-radius: 10px; font-size: 9px; margin-left: 8px; font-family: 'Inter', sans-serif;">{{ product.badge }}</span>{% endif %}
                                </div>
                                <div style="color: #888; font-size: 11px; margin-top: 2px;">{{ product.description|slice(0, 40) }}...</div>
                            </div>
                        </div>
                    </td>
                    <td style="color: #888;">{{ product.sku }}</td>
                    <td>
                        <div style="color: #fff;">{{ product.category }}</div>
                        <div style="color: #888; font-size: 11px;">{{ product.color }} &bull; {{ product.gender|upper }}</div>
                    </td>
                    <td style="font-weight: 600;">${{ product.price }}</td>
                    <td>
                        {% if product.stockQuantity == 0 %}
                            <span class="stock-badge stock-out">Out of stock</span>
                        {% elseif product.stockQuantity <= 10 %}
                            <span class="stock-badge stock-low">Low ({{ product.stockQuantity }})</span>
                        {% else %}
                            <span class="stock-badge stock-in">In stock ({{ product.stockQuantity }})</span>
                        {% endif %}
                    </td>
                    <td>
                        <div style="color: #fff;">{{ product.createdBy.name }}</div>
                        <div style="color: #888; font-size: 11px;">{{ product.createdBy.roleLabel }}</div>
                    </td>
                    <td style="color: #888;">{{ product.createdAt|date('M d, Y') }}</td>
                    <td>
                        <div style="display: flex; gap: 8px;">
                            <a href="{{ path('app_product_show', {id: product.id}) }}" class="btn-action">VIEW</a>

                            {% if is_granted('PRODUCT_EDIT', product) %}
                                <a href="{{ path('app_product_edit', {id: product.id}) }}" class="btn-action">EDIT</a>
                            {% endif %}

                            {% if is_granted('PRODUCT_DELETE', product) %}
                                <form method="post" action="{{ path('app_product_delete', {id: product.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                                    <button type="submit" class="btn-action btn-delete">DELETE</button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" style="text-align: center; color: #888; padding: 40px;">No products found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
