{% extends 'base.html.twig' %}

{% block title %}Staff Dashboard | StrideX Portal{% endblock %}

{% block body %}
<style>
    .staff-dashboard { max-width: 1440px; margin: 0 auto; }

    .staff-dashboard-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 20px;
    }

    .staff-eyebrow { margin-bottom: 6px; color: #f04424; font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
    .staff-title { margin: 0; color: #f7f8fa; font-size: clamp(29px, 3vw, 36px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.15; }
    .staff-subtitle { max-width: 620px; margin: 6px 0 0; color: #a4acb9; font-size: 13px; line-height: 1.55; }
    .staff-header-actions { display: flex; flex-wrap: wrap; gap: 9px; }

    .staff-button {
        display: inline-flex;
        min-height: 38px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 13px;
        border: 1px solid #3a4049;
        border-radius: 6px;
        background: #15191e;
        color: #e8ebef;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
    }

    .staff-button:hover { border-color: #68717e; background: #1b2026; }
    .staff-button-primary { border-color: #f04424; background: #ed3b27; color: #fff; }
    .staff-button-primary:hover { border-color: #ff6a4e; background: #f24a33; }
    .staff-button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }

    .staff-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; margin-bottom: 16px; }
    .staff-stat-card { position: relative; min-width: 0; overflow: hidden; border: 1px solid #292e35; border-radius: 8px; background: linear-gradient(135deg, #12161b, #0d1014); padding: 17px 19px; }
    .staff-stat-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .staff-stat-label { color: #aab2c0; font-size: 12px; font-weight: 500; }
    .staff-stat-value { display: block; margin-top: 12px; color: #f7f8fa; font-size: 30px; font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
    .staff-stat-meta { display: block; margin-top: 7px; color: #7f8998; font-size: 11px; }

    .staff-stat-icon {
        display: grid;
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        place-items: center;
        border: 1px solid rgba(240, 68, 36, 0.25);
        border-radius: 9px;
        background: rgba(240, 68, 36, 0.12);
        color: #ff6240;
    }

    .staff-stat-icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
    .staff-stat-icon-neutral { border-color: #343a43; background: #20252c; color: #b7c0cc; }
    .staff-stat-icon-warning { border-color: rgba(226, 166, 58, 0.3); background: rgba(226, 166, 58, 0.1); color: #e6b34f; }

    .staff-section-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 13px; }
    .staff-panel { min-width: 0; border: 1px solid #292e35; border-radius: 8px; background: linear-gradient(135deg, #111419, #0d1014); padding: 17px 19px; }

    .staff-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; padding-bottom: 13px; border-bottom: 1px solid #292e35; }
    .staff-panel-header h2 { margin: 0; color: #f1f3f5; font-size: 16px; font-weight: 650; letter-spacing: -0.02em; }
    .staff-panel-header p { margin: 4px 0 0; color: #8993a2; font-size: 11px; }
    .staff-panel-link { flex: 0 0 auto; color: #ff6240; font-size: 11px; font-weight: 600; text-decoration: none; }
    .staff-panel-link:hover { color: #ff927b; }

    .staff-table-wrap { overflow-x: auto; }
    .staff-table { width: 100%; border-collapse: collapse; text-align: left; }
    .staff-table th { padding: 9px 8px; border-bottom: 1px solid #30353d; color: #818b99; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; }
    .staff-table td { padding: 11px 8px; border-bottom: 1px solid #242930; color: #cbd0d7; font-size: 11px; vertical-align: middle; }
    .staff-table tbody tr:last-child td { border-bottom: 0; }
    .staff-table tbody tr:hover { background: rgba(255, 255, 255, 0.025); }
    .staff-table a { color: inherit; text-decoration: none; }
    .staff-table a:hover { color: #ff6240; }
    .staff-product-name { display: block; color: #f1f3f5 !important; font-size: 12px; font-weight: 600; }
    .staff-product-meta { display: block; margin-top: 4px; color: #808a98; font-size: 10px; }
    .staff-sku { color: #aab2c0; font-family: Consolas, monospace; font-size: 10px; white-space: nowrap; }

    .staff-stock-badge,
    .staff-access-badge {
        display: inline-flex;
        align-items: center;
        border: 1px solid #343a43;
        border-radius: 14px;
        background: #1a1f25;
        color: #b8c0cb;
        font-size: 10px;
        line-height: 1;
        padding: 5px 8px;
        white-space: nowrap;
    }

    .staff-stock-low { border-color: rgba(230, 179, 79, 0.35); background: rgba(230, 179, 79, 0.08); color: #e6b34f; }
    .staff-stock-out { border-color: rgba(240, 68, 36, 0.35); background: rgba(240, 68, 36, 0.1); color: #ff755d; }
    .staff-access-own { border-color: rgba(45, 181, 116, 0.3); background: rgba(45, 181, 116, 0.08); color: #54ce91; }

    .staff-row-action { color: #ff6240 !important; font-size: 10px; font-weight: 600; white-space: nowrap; }

    .staff-empty-state { display: grid; min-height: 165px; align-content: center; justify-items: center; gap: 10px; padding: 22px; color: #929ba8; text-align: center; }
    .staff-empty-state svg { width: 30px; height: 30px; fill: none; stroke: #717b88; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
    .staff-empty-state p { margin: 0; font-size: 12px; }

    @media (max-width: 1050px) {
        .staff-section-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 760px) {
        .staff-dashboard-header { align-items: flex-start; flex-direction: column; gap: 15px; }
        .staff-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .staff-stat-card:last-child { grid-column: 1 / -1; }
        .staff-panel { padding: 15px 13px; }
    }

    @media (max-width: 420px) {
        .staff-stats { grid-template-columns: 1fr; }
        .staff-stat-card:last-child { grid-column: auto; }
        .staff-header-actions { width: 100%; }
        .staff-header-actions .staff-button { flex: 1; }
        .staff-panel-header { align-items: flex-start; flex-direction: column; }
        .staff-table { min-width: 490px; }
    }

    .staff-eyebrow { color: #ff5a1f; }
    .staff-title { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; letter-spacing: 0.05em; line-height: 1; }
    .staff-subtitle { color: #888; font-size: 14px; }
    .staff-button { border-color: #333; border-radius: 4px; background: transparent; color: #fff; font-weight: 700; }
    .staff-button:hover { border-color: #fff; background: #fff; color: #000; }
    .staff-button-primary,
    .staff-button-primary:hover { border-color: #ff5a1f; background: #ff5a1f; color: #fff; }
    .staff-stats { gap: 20px; margin-bottom: 30px; }
    .staff-stat-card,
    .staff-panel { border-color: #222; border-radius: 8px; background: #0e0e0e; }
    .staff-stat-card { padding: 24px; }
    .staff-stat-label { color: #888; font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
    .staff-stat-value { color: #fff; font-size: 32px; letter-spacing: 0; }
    .staff-stat-meta { color: #666; }
    .staff-stat-icon { border-color: rgba(255, 90, 31, 0.3); background: rgba(255, 90, 31, 0.12); color: #ff5a1f; }
    .staff-stat-icon-neutral { border-color: #333; background: #111; color: #aaa; }
    .staff-stat-icon-warning { border-color: rgba(255, 90, 31, 0.3); background: rgba(255, 90, 31, 0.12); color: #ff5a1f; }
    .staff-panel { padding: 24px; }
    .staff-panel-header { margin-bottom: 20px; padding-bottom: 15px; border-bottom-color: #222; }
    .staff-panel-header h2 { color: #fff; font-family: 'Bebas Neue', sans-serif; font-size: 28px; letter-spacing: 0.05em; }
    .staff-panel-header p { color: #888; font-size: 12px; }
    .staff-panel-link,
    .staff-row-action { color: #ff5a1f !important; }
    .staff-panel-link:hover { color: #fff; }
    .staff-table th { padding: 16px; border-bottom-color: #222; background: #111; color: #888; font-size: 10px; letter-spacing: 0.1em; }
    .staff-table td { padding: 16px; border-bottom-color: #222; color: #ccc; font-size: 13px; }
    .staff-table tbody tr:hover { background: rgba(255, 255, 255, 0.02); }
    .staff-product-name { color: #ff5a1f !important; font-family: 'Bebas Neue', sans-serif; font-size: 18px; letter-spacing: 0.05em; text-transform: uppercase; }
    .staff-product-meta { color: #888; font-size: 11px; }
    .staff-sku { color: #888; }
    .staff-empty-state { color: #888; }

</style>

<div class="staff-dashboard">
    <header class="staff-dashboard-header">
        <div>
            <div class="staff-eyebrow">Staff Workspace</div>
            <h1 class="staff-title">Welcome back, {{ app.user.name }}</h1>
            <p class="staff-subtitle">Manage the product records you own and browse the shared StrideX inventory.</p>
        </div>
        <div class="staff-header-actions">
            <a href="{{ path('app_product_index', {scope: 'mine'}) }}" class="staff-button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16"/><circle cx="8" cy="5" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="10" cy="19" r="1"/></svg>
                <span>My Inventory</span>
            </a>
            <a href="{{ path('app_product_new') }}" class="staff-button staff-button-primary">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span>Create Product</span>
            </a>
        </div>
    </header>

    <section class="staff-stats" aria-label="Inventory summary">
        <article class="staff-stat-card">
            <div class="staff-stat-top">
                <div>
                    <span class="staff-stat-label">My Product Records</span>
                    <strong class="staff-stat-value" id="staff-my-products">{{ myProductCount }}</strong>
                </div>
                <span class="staff-stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 8 9 5 9-5M3 8v10l9 5 9-5V8M12 13v10"/></svg>
                </span>
            </div>
            <span class="staff-stat-meta">Records you created and can edit</span>
        </article>

        <article class="staff-stat-card">
            <div class="staff-stat-top">
                <div>
                    <span class="staff-stat-label">Shared Catalog</span>
                    <strong class="staff-stat-value" id="staff-shared-products">{{ totalSharedProducts }}</strong>
                </div>
                <span class="staff-stat-icon staff-stat-icon-neutral" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
                </span>
            </div>
            <span class="staff-stat-meta">Products across the whole team</span>
        </article>

        <article class="staff-stat-card">
            <div class="staff-stat-top">
                <div>
                    <span class="staff-stat-label">Low / Out of Stock</span>
                    <strong class="staff-stat-value" id="staff-low-stock">{{ lowStockCount }}</strong>
                </div>
                <span class="staff-stat-icon staff-stat-icon-warning" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M10.3 3.9 2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4M12 17h.01"/></svg>
                </span>
            </div>
            <span class="staff-stat-meta">Products with 10 or fewer units</span>
        </article>
    </section>

    <div class="staff-section-grid">
        <section class="staff-panel" aria-labelledby="staff-recent-products">
            <header class="staff-panel-header">
                <div>
                    <h2 id="staff-recent-products">My Recent Products</h2>
                    <p>Your latest records and quick editing access.</p>
                </div>
                <a href="{{ path('app_product_index', {scope: 'mine'}) }}" class="staff-panel-link">View all mine &rarr;</a>
            </header>

            {% if myRecentProducts is empty %}
                <div class="staff-empty-state">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 8 9 5 9-5M3 8v10l9 5 9-5V8M12 13v10"/></svg>
                    <p>You have not created any product records yet.</p>
                    <a href="{{ path('app_product_new') }}" class="staff-button staff-button-primary">Create your first product</a>
                </div>
            {% else %}
                <div class="staff-table-wrap">
                    <table class="staff-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product in myRecentProducts %}
                                <tr>
                                    <td>
                                        <a class="staff-product-name" href="{{ path('app_product_show', {id: product.id}) }}">{{ product.name }}</a>
                                        <span class="staff-product-meta">{{ product.category }}</span>
                                    </td>
                                    <td><span class="staff-sku">{{ product.sku }}</span></td>
                                    <td>${{ product.price|number_format(2) }}</td>
                                    <td>
                                        <span class="staff-stock-badge {{ product.stockQuantity == 0 ? 'staff-stock-out' : (product.stockQuantity <= 10 ? 'staff-stock-low' : '') }}">
                                            {{ product.stockQuantity }} units
                                        </span>
                                    </td>
                                    <td><a href="{{ path('app_product_edit', {id: product.id}) }}" class="staff-row-action">Edit</a></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        <section class="staff-panel" aria-labelledby="staff-shared-catalog">
            <header class="staff-panel-header">
                <div>
                    <h2 id="staff-shared-catalog">Recent Shared Catalog</h2>
                    <p>Browse records created by the whole team.</p>
                </div>
                <a href="{{ path('app_product_index') }}" class="staff-panel-link">Browse all &rarr;</a>
            </header>

            {% if recentSharedProducts is empty %}
                <div class="staff-empty-state">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
                    <p>No products found in the catalog.</p>
                </div>
            {% else %}
                <div class="staff-table-wrap">
                    <table class="staff-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Created By</th>
                                <th>Price</th>
                                <th>Access</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product in recentSharedProducts %}
                                <tr>
                                    <td>
                                        <a class="staff-product-name" href="{{ path('app_product_show', {id: product.id}) }}">{{ product.name }}</a>
                                        <span class="staff-product-meta">{{ product.sku }}</span>
                                    </td>
                                    <td>
                                        {{ product.createdBy.name }}
                                        {% if product.createdBy.id == app.user.id %}
                                            <span class="staff-access-badge staff-access-own">You</span>
                                        {% endif %}
                                    </td>
                                    <td>${{ product.price|number_format(2) }}</td>
                                    <td>
                                        {% if is_granted('PRODUCT_EDIT', product) %}
                                            <a href="{{ path('app_product_edit', {id: product.id}) }}" class="staff-row-action">Edit</a>
                                        {% else %}
                                            <span class="staff-access-badge">View only</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
